{
  "name": "osm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --only auth,database --project demo-osm \"node scripts/e2e.ts --build\"",
    "emulators": "firebase emulators:start --only auth,database --project demo-osm",
    "migrate:accounts": "node scripts/migrate-legacy-accounts.ts",
    "check:env": "node scripts/check-production-env.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@material-tailwind/react": "3.0.0-beta.24",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.12.2",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-spinners": "^0.15.0",
    "react-toastify": "^11.0.5",
    "server-only": "^0.0.1",
    "sweetalert2": "^11.26.25",
    "swiper": "12.2.0",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.6",
    "firebase-tools": "^15.31.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "gaxios@^6": {
      "uuid": "^11.1.1"
    }
  }
}
